# Copy to .env.local for local use. Restart Next after changing settings.
# Keep real credentials and cookie files out of source control and public/.

# Required media service. Configure and start Cobalt separately.
COBALT_URL=http://127.0.0.1:9000

# Optional second Cobalt instance, for example http://127.0.0.1:9001.
COBALT_PROXY_URL=

# YouTube fallback executable, installed separately.
YTDLP_PATH=yt-dlp

# Optional path to a cookie file outside this project.
YTDLP_COOKIES=

# Optional comma separated proxy URLs. Add real values only in private config.
YTDLP_PROXY=

# Optional listening port. Hosting may supply this automatically.
# PORT=3000
